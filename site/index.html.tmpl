        <div><p class="cmd-label" id="bin-linux-x64-label">linux-x64</p>
        <div class="cmd"><textarea id="bin-linux-x64" readonly rows="2" aria-labelledby="bin-linux-x64-label" spellcheck="false">curl -fsSL https://raw.githubusercontent.com/GhostPawJS/telegram/main/install.sh | sh -s -- --target linux-x64 &amp;&amp; export PATH=&quot;$HOME/.local/bin:$PATH&quot;</textarea><button type="button" class="copy" data-copy="bin-linux-x64">Copy</button></div></div>
        <div><p class="cmd-label" id="bin-linux-arm64-label">linux-arm64</p>
        <div class="cmd"><textarea id="bin-linux-arm64" readonly rows="2" aria-labelledby="bin-linux-arm64-label" spellcheck="false">curl -fsSL https://raw.githubusercontent.com/GhostPawJS/telegram/main/install.sh | sh -s -- --target linux-arm64 &amp;&amp; export PATH=&quot;$HOME/.local/bin:$PATH&quot;</textarea><button type="button" class="copy" data-copy="bin-linux-arm64">Copy</button></div></div>
        <div><p class="cmd-label" id="bin-darwin-arm64-label">darwin-arm64</p>
        <div class="cmd"><textarea id="bin-darwin-arm64" readonly rows="2" aria-labelledby="bin-darwin-arm64-label" spellcheck="false">curl -fsSL https://raw.githubusercontent.com/GhostPawJS/telegram/main/install.sh | sh -s -- --target darwin-arm64 &amp;&amp; export PATH=&quot;$HOME/.local/bin:$PATH&quot;</textarea><button type="button" class="copy" data-copy="bin-darwin-arm64">Copy</button></div></div>
        <div><p class="cmd-label" id="bin-darwin-x64-label">darwin-x64</p>
        <div class="cmd"><textarea id="bin-darwin-x64" readonly rows="2" aria-labelledby="bin-darwin-x64-label" spellcheck="false">curl -fsSL https://raw.githubusercontent.com/GhostPawJS/telegram/main/install.sh | sh -s -- --target darwin-x64 &amp;&amp; export PATH=&quot;$HOME/.local/bin:$PATH&quot;</textarea><button type="button" class="copy" data-copy="bin-darwin-x64">Copy</button></div></div>
        <div><p class="cmd-label" id="bin-windows-x64-label">windows-x64 (PowerShell)</p>
        <div class="cmd"><textarea id="bin-windows-x64" readonly rows="2" aria-labelledby="bin-windows-x64-label" spellcheck="false">irm https://raw.githubusercontent.com/GhostPawJS/telegram/main/install.ps1 | iex</textarea><button type="button" class="copy" data-copy="bin-windows-x64">Copy</button></div></div>
